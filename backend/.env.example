FLASK_ENV=development
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-in-production

# MySQL connection — default matches root / no password on localhost
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anametaiot_hrms

COMPANY_NAME=AnametaIOT HRMS
POWERED_BY=+veGroww

# --- Optional integrations (recruitment features work without these; see
#     README "External Integrations" section for what each unlocks) ---

# AI-assisted grading + screening-call summary/classification.
# Without this, both fall back to a labeled heuristic — the app still works.
ANTHROPIC_API_KEY=

# AI voice-bot screening calls. Without these, calls are simulated so the
# rest of the screening flow can be built/tested/used end to end.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# One-click job posting to LinkedIn / Naukri. Requires partner API access
# that must be provisioned independently — see the Recruiter Specification,
# Section 18/21, for what each of these actually requires.
LINKEDIN_API_TOKEN=
NAUKRI_API_TOKEN=
